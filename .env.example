# Application
APP_NAME=Development of AI-Based Knowledge Retrieval Platform with Query Resolution System
DEBUG=true

# PostgreSQL (async SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/AI-QUERY-SYSTEM

# JWT — change JWT_SECRET_KEY before deploying
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookies (set COOKIE_SECURE=true behind HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

# Frontend origins for CORS (credentials enabled)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ChromaDB — "http" targets the Docker server, "embedded" writes to chromadb/
CHROMA_MODE=embedded
# CHROMA_MODE=http
# CHROMA_HOST=localhost
# CHROMA_PORT=6334

# Chat LLM — "ollama" (local) or "openai" (GPT)
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.0

# Ollama (when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=granite4.1:8b
LLM_SEED=42
# Lower this (e.g. 2048) if Ollama reports insufficient system memory
LLM_NUM_CTX=4096

# OpenAI GPT (when LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Agentic retrieval
RETRIEVAL_SCORE_THRESHOLD=0.3
DEFAULT_RETRIEVAL_K=5
MAX_TOOL_CALLS=8
MAX_ITERATIONS=10
GRAPH_RECURSION_LIMIT=50
MAIN_HISTORY_MESSAGES_TO_KEEP=4
BASE_TOKEN_THRESHOLD=2000
TOKEN_GROWTH_FACTOR=0.9
EXECUTION_LOGGING_ENABLED=false

# ElevenLabs speech (STT/TTS) — server-side only; never expose to the browser
SPEECH_ENABLED=true
ELEVENLABS_API_KEY=your-key-here
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_STT_REALTIME_MODEL=scribe_v2_realtime
ELEVENLABS_STT_REALTIME_AUDIO_FORMAT=pcm_16000
ELEVENLABS_STT_REALTIME_COMMIT_STRATEGY=vad
ELEVENLABS_STT_REALTIME_VAD_SILENCE_SECS=1.0
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Premade voice ID (free-tier API). Voice Library IDs require a paid plan.
# Sarah (premade): EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_TTS_OUTPUT_FORMAT=mp3_44100_128
SPEECH_MAX_TTS_CHARS=5000
SPEECH_REQUEST_TIMEOUT_SECONDS=120

# Temporary Gradio UI (uv run python -m app.ui.gradio_app)
GRADIO_ENABLED=true
GRADIO_SHARE=false
